{
  "name": "ddd-challenge",
  "version": "0.1.0",
  "private": true,
  "description": "プラハチャレンジをDDDで実装してみる",
  "license": "UNLICENSED",
  "author": "Seiha Tsuge",
  "repository": {
    "type": "git",
    "url": "https://github.com/seiha-tsuge/ddd-challenge.git"
  },
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "reset": "pnpm ci",
    "start": "node dist/index.js",
    "test": "node --import tsx --test test/domain/shared/value-objects.test.ts",
    "typecheck": "oxlint --type-aware --type-check"
  },
  "dependencies": {
    "@hono/node-server": "2.1.1",
    "hono": "4.13.3",
    "uuid": "14.0.2"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "lefthook": "2.1.10",
    "oxfmt": "0.64.0",
    "oxlint": "1.79.0",
    "oxlint-tsgolint": "7.0.2001",
    "tsx": "4.23.0",
    "typescript": "7.0.2"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.22.0",
      "onFail": "warn"
    },
    "runtime": {
      "name": "node",
      "version": "24.18.0",
      "onFail": "warn"
    }
  },
  "engines": {
    "node": "24.18.0",
    "pnpm": "11.22.0"
  },
  "packageManager": "pnpm@11.22.0"
}
